{
  "schema_version": "3.0",
  "purpose": "布局手艺默认值。项目可调数值，不是目标规范强制要求。",
  "matlab_version": "R2025b",
  "grid": 10,
  "block": {
    "width": 40,
    "height": 40,
    "port_width": 30,
    "port_height": 14
  },
  "spacing": {
    "horizontal": 60,
    "vertical": 40,
    "margin": 40,
    "lane_gap": 20
  },
  "goto_from": {
    "budget_tiers": [[20, 1], [60, 2], [null, 3]],
    "hard_cap": 3,
    "max_froms_per_tag": 2,
    "tag_visibility": "local",
    "forbid_inport_to_goto": true,
    "forbid_from_to_goto_chaining": true
  },
  "residual": {
    "max_crossing_events": 2,
    "max_involved_lines": 2,
    "note": "几何手段穷尽后允许书面遗留的极小残留；交付报告列出线对与实际 crossing style，并逐张 PNG 复核。"
  },
  "repair": {
    "max_rounds_without_improvement": 3
  }
}
